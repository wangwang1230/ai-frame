{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/v1/schema.json",
  "build": {
    "beforeDevCommand": "pnpm --filter desktop exec vite dev",
    "beforeBuildCommand": "pnpm --filter desktop exec vite build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "AI Frame",
    "version": "0.1.0"
  },
  "tauri": {
    "windows": [
      {
        "title": "AI Frame Desktop",
        "width": 1280,
        "height": 800,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
