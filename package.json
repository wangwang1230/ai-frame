{
  "name": "ai-frame",
  "private": true,
  "packageManager": "pnpm@8.15.7",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:desktop": "pnpm --filter desktop tauri dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^1.12.3",
    "typescript": "^5.4.5",
    "eslint": "^8.57.0"
  }
}
